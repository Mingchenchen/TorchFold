+  ) -> tuple[Self, Any]:
+      """Reference structure information for each residue."""
+
+      # Get features per atom
+      padded_shape = (padding_shapes.num_tokens, all_token_atoms_layout.shape[1])
+      result = {
+          'positions': np.zeros((*padded_shape, 3), 'float32'),
+          'mask': np.zeros(padded_shape, 'bool'),
+          'element': np.zeros(padded_shape, 'int32'),
+          'charge': np.zeros(padded_shape, 'float32'),
+          'atom_name_chars': np.zeros((*padded_shape, 4), 'int32'),
+          'ref_space_uid': np.zeros((*padded_shape,), 'int32'),
+      }
+
+      atom_names_all = []
+      chain_ids_all = []
+      res_ids_all = []
+
+      # Cache reference conformations for each residue.
+      conformations = {}
+      ref_space_uids = {}
+
+      # Collect unique (chain_id, res_id, res_name) combinations in original order
+      unique_residues = []
+      seen_keys = set()
+      for idx in np.ndindex(all_token_atoms_layout.shape):
+          chain_id = all_token_atoms_layout.chain_id[idx]
+          res_id = all_token_atoms_layout.res_id[idx]
+          res_name = all_token_atoms_layout.res_name[idx]
+          key = (chain_id, res_id)
+          if key not in seen_keys:
+              unique_residues.append((chain_id, res_id, res_name))
+              seen_keys.add(key)
+
+      # Pre-extract random state snapshots for each residue in original order
+      random_state_snapshots = []
+      current_state = random_state.get_state()
+      for chain_id, res_id, res_name in unique_residues:
+          random_state.set_state(current_state)
+          snapshot = random_state.get_state()
+          random_state_snapshots.append(snapshot)
+          _ = random_state.randint(1, 1 << 31)  # conformer_random_seed
+          _ = random_state.normal(size=(2, 3))  # random_rotation
+          _ = random_state.normal(size=(3,))  # translation
+          # Save the new state for the next iteration
+          current_state = random_state.get_state()
+
+      # Parallel processing: pre-compute all conformations
+      def _get_reference_wrapper(args):
+          """Wrapper function for parallel get_reference calls."""
+          chain_id, res_id, res_name, state_snapshot = args
+          # Create a new RandomState with the saved state
+          local_random_state = np.random.RandomState()
+          local_random_state.set_state(state_snapshot)
+          try:
+              conf, from_atom, dest_atom = get_reference(
+                  res_name=res_name,
+                  chemical_components_data=chemical_components_data,
+                  ccd=ccd,
+                  random_state=local_random_state,
+                  ref_max_modified_date=ref_max_modified_date,
+                  conformer_max_iterations=conformer_max_iterations,
+              )
+              return (chain_id, res_id), conf, from_atom, dest_atom, res_name
+          except Exception as e:
+              logging.error(
+                  'Error processing residue %s (%s, %s): %s',
+                  res_name, chain_id, res_id, str(e)
+              )
+              raise
+
+      # Prepare arguments for parallel execution
+      parallel_args = []
+      for (chain_id, res_id, res_name), state_snapshot in zip(unique_residues, random_state_snapshots):
+          parallel_args.append((chain_id, res_id, res_name, state_snapshot))
+
+      # Execute get_reference calls in parallel
+      bond_info = {}  # Store from_atom, dest_atom, res_name for each (chain_id, res_id)
+      # Use max_workers if provided, otherwise use default (typically CPU count)
+      with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
+          futures = {executor.submit(_get_reference_wrapper, args): args
+                     for args in parallel_args}
+          for future in concurrent.futures.as_completed(futures):
+              try:
+                  key, conf, from_atom, dest_atom, res_name = future.result()
+                  conformations[key] = conf
+                  bond_info[key] = (from_atom, dest_atom, res_name)
+              except Exception as e:
+                  chain_id, res_id, res_name, _ = futures[future]
+                  logging.error(
+                      'Failed to process residue %s (%s, %s): %s',
+                      res_name, chain_id, res_id, str(e)
+                  )
+                  # Set default conformation on error
+                  conformations[(chain_id, res_id)] = {}
+                  bond_info[(chain_id, res_id)] = (None, None, res_name)
+
+      # Process bond information for non-standard residues (only once per residue)
+      processed_bonds = set()
+      for chain_id, res_id, res_name in unique_residues:
+          key = (chain_id, res_id)
+          is_non_standard = res_name not in _STANDARD_RESIDUES
+          if key in bond_info:
+              from_atom, dest_atom, _ = bond_info[key]
+              if (
+                      is_non_standard
+                      and (from_atom is not None)
+                      and (dest_atom is not None)
+                      and key not in processed_bonds
+              ):
+                  # Add intra-ligand bond graph
+                  atom_names_ligand = np.stack(
+                      [from_atom, dest_atom], axis=1, dtype=object
+                  )
+                  atom_names_all.append(atom_names_ligand)
+                  res_ids_all.append(
+                      np.full_like(atom_names_ligand, res_id, dtype=int)
+                  )
+                  chain_ids_all.append(
+                      np.full_like(atom_names_ligand, chain_id, dtype=object)
+                  )
+                  processed_bonds.add(key)
+
+      # Process all atoms using pre-computed conformations
+      for idx in np.ndindex(all_token_atoms_layout.shape):
+          chain_id = all_token_atoms_layout.chain_id[idx]
+          res_id = all_token_atoms_layout.res_id[idx]
+          res_name = all_token_atoms_layout.res_name[idx]
+          atom_name = all_token_atoms_layout.atom_name[idx]
+          if not atom_name:
+              ref = _DEFAULT_BLANK_REF
+          else:
+              key = (chain_id, res_id)
+              conformation = conformations.get(
+                  key, {atom_name: _DEFAULT_BLANK_REF}
+              )
+              if atom_name not in conformation:
+                  logging.warning(
+                      'Missing atom "%s" for CCD "%s"',
+                      atom_name,
